# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Supabase Database Configuration
# Get this from: https://supabase.com/dashboard → Your Project → Settings → Database → Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?sslmode=require

# Firebase Admin SDK Configuration
# Get these from: https://console.firebase.google.com → Project Settings → Service Accounts → Generate new private key
# FIREBASE_PROJECT_ID: Your Firebase project ID (e.g., "cloudcanvas-architect")
# FIREBASE_CLIENT_EMAIL: Service account email (e.g., "firebase-adminsdk-abc123@cloudcanvas-architect.iam.gserviceaccount.com")
# FIREBASE_PRIVATE_KEY: Private key from the service account JSON (replace \n with literal newlines or use \\n in the env file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

AWS_REGION=us-east-1
AWS_PRICING_API_CACHE_HOURS=24

# Logging
LOG_LEVEL=debug
